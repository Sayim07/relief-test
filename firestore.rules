rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is an admin - SAFER EVALUATION
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, list: if isAuthenticated();
      // Temporarily allow anyone to create an admin profile for the first admin setup
      // WARNING: Revert this to "if false" or "if isAdmin()" after creating the first admin
      allow create: if isAuthenticated() && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    // Donors collection
    match /donors/{donorId} {
      allow read, list: if isAuthenticated();
      allow write: if request.auth != null && request.auth.uid == donorId;
    }

    // Generic Users collection
    match /users/{userId} {
      allow read, list: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Relief Partners collection
    match /relief_partners/{partnerId} {
      allow read, list: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == partnerId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Funds collection
    match /funds/{fundId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Donations collection
    match /donations/{donationId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.donorId == request.auth.uid);
      allow list: if isAdmin() || (request.auth != null && (request.auth.uid == request.resource.data.donorId || request.auth.uid == resource.data.donorId)); // Simplified for list
      allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Relief Partner Assignments
    match /assignments/{assignmentId} {
      allow read, list: if isAdmin() || isAuthenticated();
      allow write: if isAdmin();
    }

    // Receipts collection
    match /receipts/{receiptId} {
      allow read, list: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // Verification Tickets collection
    match /verification_tickets/{ticketId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (request.auth != null && (request.auth.uid == resource.data.uid || request.auth.uid == request.resource.data.uid)); // Allow admin or self
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Relief Requests collection
    match /relief_requests/{requestId} {
      allow read, list: if true;
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // Transactions collection (Ledger)
    match /transactions/{txHash} {
      allow read, list: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
